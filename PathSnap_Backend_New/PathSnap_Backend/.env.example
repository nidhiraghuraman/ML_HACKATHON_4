# Copy to .env and edit. No secrets are needed by PathSnap.
# Port the API listens on (all network interfaces, 0.0.0.0)
PORT=8000
# Which trips are served: PATHSNAP_RAW_DIR/PATHSNAP_PARTITION/<trip_id>/
# Development: data/raw + student_test.  Evaluator trips: data/external_evaluator + evaluator_test
PATHSNAP_RAW_DIR=data/raw
PATHSNAP_PARTITION=student_test
# 1 = if a trip folder contains a .route file, compute accuracy on the server (the route is never sent to the browser)
PATHSNAP_EVALUATE=1
# Which browser origins may call the API. "*" = any. Safer: the frontend's URL, e.g. http://192.168.1.20:5173
PATHSNAP_CORS_ORIGINS=*
